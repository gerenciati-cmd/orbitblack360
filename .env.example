PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=orbitblack360_dev

# Secretos: genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto

# Usuario administrador de la plataforma (lo crea `npm run seed`)
SEED_ADMIN_EMAIL=admin@orbitblack360.local
SEED_ADMIN_PASSWORD=cambia-esto-ya

# --- Cobro con Stripe (opcional: sin esto la plataforma funciona y el cobro responde "no configurado") ---
APP_URL=http://localhost:5173
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Un Price (suscripción mensual) por plan, creado en el dashboard de Stripe
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
